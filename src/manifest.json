{
    "name" : "UVEL",
    "appid" : "",
    "description" : "",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    "h5": {
        "async": { "error": "NexGridPageLoadError" }
    },
    /* 5+App特有相关 */
    "app-plus" : {
        "darkmode" : true,
        "usingComponents" : true,
        "nvueStyleCompiler" : "uni-app",
        "compilerVersion" : 3,
        "splashscreen" : {
            "alwaysShowBeforeRender" : true,
            "waiting" : true,
            "autoclose" : true,
            "delay" : 0
        },
        /* 模块配置 */
        "modules" : { "Barcode": {} },
        /* 应用发布信息 */
        "distribute" : {
            "icons": {
                "android": {
                    "mdpi": "static/app-icons/android/icon-48.png",
                    "hdpi": "static/app-icons/android/icon-72.png",
                    "xhdpi": "static/app-icons/android/icon-96.png",
                    "xxhdpi": "static/app-icons/android/icon-144.png",
                    "xxxhdpi": "static/app-icons/android/icon-192.png"
                },
                "ios": {
                    "appstore": "static/app-icons/ios/icon-1024.png",
                    "iphone": {
                        "app@2x": "static/app-icons/ios/icon-120.png",
                        "app@3x": "static/app-icons/ios/icon-180.png",
                        "notification@2x": "static/app-icons/ios/icon-40.png",
                        "notification@3x": "static/app-icons/ios/icon-60.png",
                        "settings@2x": "static/app-icons/ios/icon-58.png",
                        "settings@3x": "static/app-icons/ios/icon-87.png",
                        "spotlight@2x": "static/app-icons/ios/icon-80.png",
                        "spotlight@3x": "static/app-icons/ios/icon-120.png"
                    },
                    "ipad": {
                        "app": "static/app-icons/ios/icon-76.png",
                        "app@2x": "static/app-icons/ios/icon-152.png",
                        "proapp@2x": "static/app-icons/ios/icon-167.png",
                        "notification": "static/app-icons/ios/icon-20.png",
                        "notification@2x": "static/app-icons/ios/icon-40.png",
                        "settings": "static/app-icons/ios/icon-29.png",
                        "settings@2x": "static/app-icons/ios/icon-58.png",
                        "spotlight": "static/app-icons/ios/icon-40.png",
                        "spotlight@2x": "static/app-icons/ios/icon-80.png"
                    }
                }
            },
            /* android打包配置 */
            "android" : {
                "enableOAID": false,
                "schemes": "uvel",
                "permissions" : [
                    "<uses-permission android:name=\"android.permission.CHANGE_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.MOUNT_UNMOUNT_FILESYSTEMS\"/>",
                    "<uses-permission android:name=\"android.permission.VIBRATE\"/>",
                    "<uses-permission android:name=\"android.permission.READ_LOGS\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_WIFI_STATE\"/>",
                    "<uses-feature android:name=\"android.hardware.camera.autofocus\"/>",
                    "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CAMERA\"/>",
                    "<uses-permission android:name=\"android.permission.GET_ACCOUNTS\"/>",
                    "<uses-permission android:name=\"android.permission.READ_PHONE_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.CHANGE_WIFI_STATE\"/>",
                    "<uses-permission android:name=\"android.permission.WAKE_LOCK\"/>",
                    "<uses-permission android:name=\"android.permission.FLASHLIGHT\"/>",
                    "<uses-feature android:name=\"android.hardware.camera\"/>",
                    "<uses-permission android:name=\"android.permission.WRITE_SETTINGS\"/>"
                ]
            },
            /* ios打包配置 */
            "ios" : { "urltypes": "uvel" },
            /* SDK配置 */
            "sdkConfigs" : {}
        }
    },
    /* 快应用特有相关 */
    "quickapp" : {},
    /* 小程序特有相关 */
    "mp-weixin" : {
        "appid" : "",
        "setting" : {
            "urlCheck" : false
        },
        "usingComponents" : true
    },
    "mp-alipay" : {
        "usingComponents" : true
    },
    "mp-baidu" : {
        "usingComponents" : true
    },
    "mp-toutiao" : {
        "usingComponents" : true
    },
    "uniStatistics": {  
        "enable": false
    },
    "vueVersion" : "3"
}
