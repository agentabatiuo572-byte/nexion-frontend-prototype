# The formal UniApp uses Vite's standard development/production environments.
# It never selects backend business authority with a sandbox/remote flag.
# Development H5 proxies same-origin API calls to the local Java dev service.
VITE_NEXGRID_API_PREVIEW_TARGET=http://127.0.0.1:8110
# VITE_NEXGRID_API_PREVIEW_EDGE_COUNTRY=JP
VITE_NEXGRID_DEV_OTP_CODE=

# Production normally uses the deployed browser origin. Configure this only
# when the Java prod API is hosted on another origin.
# VITE_NEXGRID_API_BASE_URL=https://api.example.invalid
