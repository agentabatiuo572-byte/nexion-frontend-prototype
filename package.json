    "build:mp-jd": "uni build -p mp-jd",
    "build:mp-kuaishou": "uni build -p mp-kuaishou",
    "build:mp-lark": "uni build -p mp-lark",
    "build:mp-qq": "uni build -p mp-qq",
    "build:mp-toutiao": "uni build -p mp-toutiao",
    "build:mp-harmony": "uni build -p mp-harmony",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-xhs": "uni build -p mp-xhs",
    "build:quickapp-webview": "uni build -p quickapp-webview",
    "build:quickapp-webview-huawei": "uni build -p quickapp-webview-huawei",
    "build:quickapp-webview-union": "uni build -p quickapp-webview-union",
    "type-check": "vue-tsc --noEmit",
    "type-check:cached": "node scripts/typecheck-cached.mjs",
    "test:contract-registry": "node scripts/frontend-mock-mode-contract.test.mjs && node --test scripts/external-market-removal-contract.test.mjs scripts/final-trust-market-contract.test.mjs scripts/keyboard-submit-contract.test.mjs scripts/leadership-pool-consumers.test.mjs",
    "test:unit": "vitest run",
    "test:final-commerce-closure": "node --test scripts/final-commerce-closure-contract.test.mjs",
    "test:phase-isolation": "node --test scripts/phase-isolation-contract.test.mjs",
    "test:kyc-removal": "node --test scripts/kyc-removal-contract.test.mjs",
    "test:probe-safety": "node --test scripts/probe-safety-contract.test.mjs scripts/static-review-routes.test.mjs scripts/verify-scope-lib.test.mjs",
    "test:earnings-accrual": "node --experimental-strip-types --test scripts/earnings-accrual-contract.test.mjs",
    "test:business-loop-liveness": "node scripts/selfcheck-business-loop-liveness.mjs",
    "test:janus-stop-cancellation": "node scripts/janus-stop-cancellation.test.mjs",
    "test:guard-liveness": "node scripts/selfcheck-guard-liveness.mjs",
    "test:h5-runtime": "node scripts/verify-h5-runtime.mjs",
    "verify": "node scripts/verify-chain.mjs --full",
    "verify:scoped": "node scripts/verify-chain.mjs --scoped",
    "verify:static": "node scripts/verify-chain.mjs --static",
    "verify:steps": "npm run type-check:cached && npm run test:githooks && npm run test:contract-registry && npm run test:uvel-brand && npm run test:unit && npm run test:fixed-mock-home && npm run build:h5",
    "test:uvel-brand": "node scripts/uvel-brand-check.mjs",
    "verify:scope-lint": "node scripts/lib/verify-scope.mjs lint",
    "verify:scope-audit": "node scripts/verify-scope-audit.mjs",
    "verify:scope-audit:deep": "node scripts/verify-scope-audit.mjs --deep",
    "test:learning-contracts": "node --experimental-strip-types --test scripts/learning-submission.test.mjs",
    "test:a11y-activate": "node --experimental-strip-types --test scripts/a11y-activate-behavior.test.mjs && node scripts/a11y-activate-gate.mjs && node scripts/a11y-activate-gate.redtest.mjs",
    "test:fixed-mock-home": "node scripts/app-home-live-e2e.mjs"
  },
