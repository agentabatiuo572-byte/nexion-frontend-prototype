    "test:githooks": "node --test .githooks/verify-before-push.test.mjs .githooks/guard-mainline-commit.test.mjs",
    "test:verify-harness": "node --test scripts/known-red.test.mjs scripts/lib/verify-scope-additive.test.mjs scripts/known-red-shell.test.mjs",
    "test:app-h5-sync": "node --test scripts/app-h5-sync.test.mjs && node scripts/app-h5-sync.mjs check",
    "sync:h5:check": "node scripts/app-h5-sync.mjs check",
    "verify": "node scripts/verify-chain.mjs --full",
    "verify:scoped": "node scripts/verify-chain.mjs --scoped",
    "verify:static": "node scripts/verify-chain.mjs --static",
    "verify:steps": "npm run type-check:cached && npm run test:githooks && npm run test:verify-harness && npm run test:app-h5-sync && npm run test:country-code-contracts && npm run test:contract-registry && npm run test:cross-repo && npm run test:kyc-removal && npm run test:probe-safety && npm run test:earnings-accrual && npm run test:business-loop-liveness && npm run test:janus-stop-cancellation && npm run test:production-boundaries && npm run test:session-reload-recovery && npm run test:guard-liveness && npm run test:a11y-activate && npm run test:learning-contracts && npm run test:real-backend-integration && npm run build:h5:prod && npm run test:prod-artifact && npm run test:h5-runtime && npm run test:withdraw-status-mirror && npm run test:legacy-suite",
    "verify:scope-lint": "node scripts/lib/verify-scope.mjs lint",
    "verify:scope-audit": "node scripts/verify-scope-audit.mjs",
    "verify:scope-audit:deep": "node scripts/verify-scope-audit.mjs --deep",
    "test:learning-contracts": "node --experimental-strip-types --test scripts/learning-submission.test.mjs",
    "test:a11y-activate": "node --experimental-strip-types --test scripts/a11y-activate-behavior.test.mjs scripts/a11y-numeric-attribute.test.mjs && node scripts/a11y-activate-gate.mjs && node scripts/a11y-activate-gate.redtest.mjs && node scripts/radio-group-keyboard-gate.mjs && node scripts/radio-group-keyboard-gate.redtest.mjs && node scripts/input-accessible-name-gate.mjs && node scripts/input-accessible-name-gate.redtest.mjs",
    "test:cross-repo": "node --test scripts/h8-run-scoped-referral-projection-contract.test.mjs scripts/behavior-analytics-active-route-catalog-contract.test.mjs && node scripts/cross-repo-skip.redtest.mjs",
    "test:quest-tripwire": "node scripts/quest-genesis-tripwire-runtime.mjs",
    "test:withdraw-status-mirror": "node scripts/withdraw-status-mirror-runtime.mjs",
    "test:legacy-suite": "node scripts/run-legacy-suite.mjs",
    "postinstall": "node scripts/liquid-glass-install.mjs && node scripts/patch-liquid-glass.mjs"
  },
