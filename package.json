    "test:h5-runtime": "node scripts/verify-h5-runtime.mjs",
    "test:country-code-contracts": "node --test scripts/country-code-selector-contract.test.mjs scripts/auth-entry-ui-contract.test.mjs && vitest run src/auth/phone-number.test.ts src/api/contracts-user-session.test.ts src/api/session-vault-cookie.test.ts src/api/auth-api-oauth.test.ts src/api/mock-auth-security.test.ts",
